# Copia este archivo a .env y completa los valores.
# En desarrollo: uv run --env-file .env python manage.py runserver

# --- Django ---
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Orígenes con https para el admin detrás de un túnel o en Railway (separados por coma)
DJANGO_CSRF_TRUSTED_ORIGINS=
# Vacío = SQLite local. En Railway: la URL de Postgres que entrega el servicio.
DATABASE_URL=
ZONA_HORARIA_DEFECTO=America/Santiago
NOMBRE_NEGOCIO=Monardez Soft

# --- WhatsApp Cloud API (Meta) ---
# Con WHATSAPP_TOKEN vacío los mensajes solo se muestran en la terminal (ClienteConsola).
# Con token se envían de verdad (ClienteGraph). Se puede forzar con WHATSAPP_CLIENTE.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=inventa-un-texto-secreto
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PLANTILLA_RECORDATORIO=recordatorio
WHATSAPP_PLANTILLA_AVISO=aviso
WHATSAPP_PLANTILLA_IDIOMA=es

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
ASISTENTE_MODELO=claude-opus-5-5
ASISTENTE_EFFORT=low

# --- Worker (Django-Q2) ---
Q_WORKERS=2
